# Server config
PORT=3001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# JWT — MUST be a long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Password reset email (Gmail app password)
EMAIL_USER=example@gmail.com
EMAIL_PASS=app-password-here

# Contact form email (Gmail app password)
CONTACT_EMAIL_USER=example@gmail.com
CONTACT_EMAIL_PASS=app-password-here

# Allowed origins for CORS & socket.io — comma separated
FRONTEND_URL=http://localhost:5173,http://localhost:3000
